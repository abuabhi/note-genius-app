{
  "headers": [
    {
      "source": "/.well-known/microsoft-identity-association.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|_next|favicon.ico|\\.well-known)(?!.*\\.(svg|png|jpg|jpeg|gif|webp|js|css|woff|woff2|ttf|eot|ico|map)).*)",
      "destination": "/index.html"
    }
  ]
}